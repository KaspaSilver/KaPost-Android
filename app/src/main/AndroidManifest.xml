<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for Kaspa node connections -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app show the OS "ignore battery optimizations" dialog so data-only encrypted
         DM/group push can wake a force-closed app (see MainActivity.maybeRequestBatteryExemption). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Voice messages -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera, for scanning address QR codes -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Saving a received photo message to the device gallery. Only needed on API 28 and below —
         API 29+ (Q) scoped storage lets MediaStore inserts succeed without this permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Vibration for notification feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Biometric/device-credential prompt guarding the seed phrase and account unlock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Play derives REQUIRED hardware from the permissions above unless it is told otherwise:
         CAMERA implies android.hardware.camera, RECORD_AUDIO implies android.hardware.microphone.
         Left implicit, the store hides the app from every device without that hardware - most
         Chromebooks, camera-less tablets, TV/auto form factors - even though KaChat is a chat app
         whose camera and microphone are optional extras (QR scanning, photos, calls). Declaring
         them required="false" keeps the app installable there; the features that need the hardware
         already check for it at runtime through the normal permission request. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- usesCleartextTraffic stays true DELIBERATELY (2026-08 security audit, decision 3A):
         Kaspa node gRPC (protowire on port 16110/16210) is plaintext by protocol, and a
         networkSecurityConfig cannot scope a cleartext allowance by port — only by domain —
         which is useless for a pool of bare peer IPs. grpc-okhttp builds its own sockets and
         does not reliably consult the platform's cleartext policy anyway, so tightening the
         flag would only give a false sense of coverage. Everything HTTP in the app (indexer,
         KNS, REST API, push registration, Nextcloud, link previews) is https-only at the
         application layer instead: the URL settings fields are read-only, and the one
         user-editable server input (Nextcloud) rejects explicit http:// in the UI and again in
         NextcloudService.normalizeServer. -->
    <!-- The Wallet's Domains tab opens KaChat Wallet, where .kachat names are managed (iOS
         KaPosts 4c0d5a8): Android 11+ only hands out another app's launch intent for a package
         listed here. -->
    <queries>
        <package android:name="com.kachat.wallet" />
        <package android:name="com.kachat.wallet.debug" />
    </queries>

    <application
        android:name=".KaChatApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaChat"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KaChat"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- KaPosts' own scheme, kaposts://, with the same targets as kachat:// (iOS KaPosts
                 registers only this one): kapost/<txid> opens the post's thread, broadcast/<channel>
                 opens (and, for a room that isn't one of the curated ones, joins) that room,
                 profile/<address> opens that person's KaPosts profile, pay/<address>?... opens Send
                 Kaspa filled in. Every target is validated before anything routes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kaposts" android:host="kapost" />
                <data android:scheme="kaposts" android:host="broadcast" />
                <data android:scheme="kaposts" android:host="profile" />
                <data android:scheme="kaposts" android:host="pay" />
            </intent-filter>
            <!-- Shared posts and rooms are still written as kachat://kapost/ and kachat://broadcast/.
                 KaChat stopped handling those two once posts and public chats left it (KaChat iOS
                 e2f6732), so KaPosts takes them; kachat://profile and kachat://pay stay KaChat's. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kachat" android:host="kapost" />
                <data android:scheme="kachat" android:host="broadcast" />
            </intent-filter>
            <!-- Universal-link form of the same two. autoVerify needs KaPosts' package in
                 kachat.app's /.well-known/assetlinks.json (the counterpart of iOS needing KaPosts'
                 app ID in the apple-app-site-association); until then Android offers these links
                 to KaPosts without verifying them. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="kachat.app" android:pathPrefix="/post/" />
                <data android:scheme="https" android:host="kachat.app" android:pathPrefix="/broadcast/" />
            </intent-filter>
        </activity>

        <!-- WorkManager's default auto-init is disabled — KaChatApplication implements
             Configuration.Provider so SyncWorker gets constructed via HiltWorkerFactory
             (see SyncWorker.kt) instead of a no-arg constructor. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Lets the chat-history export share a plaintext JSON file from app-private cache via a content:// URI, without granting broad file access. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM Push Notification Service. Data-only messages are handled here and turned into
             notifications via NotificationHelper (mirrors iOS's Notification Service Extension).
             Inactive at runtime until google-services.json is added (see app/build.gradle.kts). -->
        <service
            android:name=".services.KaChatFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Default notification channel for FCM (used if a message arrives without an explicit
             channel). Points at the app's primary messages channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="kachat_messages_sound_vibrate" />

        <!-- Required for AppCompatDelegate.setApplicationLocales() to survive a cold app
             restart on API <33 (the Settings > Language row uses this API) - without this
             meta-data entry, the per-app language backport can't auto-restore the saved
             locale on the next launch. No-op on API 33+, which has native per-app language
             support and ignores this. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
